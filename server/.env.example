# 复制为 .env 后填写。不要提交 .env。
# 微信云托管部署时不要把本文件或 .env 打进镜像；环境变量在云托管控制台配置。
# 云托管服务端口请填写 3000，并把 PORT 保持为 3000。
PORT=3000
HOST=0.0.0.0

# 必填：DeepSeek 开放平台 API Key（https://platform.deepseek.com/）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_VISION_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_MS=60000

# 旧教师口令 / 注册码兜底，请改成至少 16 位的随机字符串
ADMIN_TOKEN=replace-with-a-long-random-admin-token

# 学生匿名身份哈希盐值，请改成随机字符串；修改后历史归属会变化
CLIENT_HASH_SALT=replace-with-a-long-random-salt

# 教师邮箱注册码；不填时默认使用 ADMIN_TOKEN
TEACHER_REGISTER_CODE=
COMMENTS_PER_MINUTE=20

# ============================================================
# 教师评论服务号推送（可选）
# 需要：小程序 AppID/Secret、同主体的服务号、服务号模板消息 ID
# 学生需已关注服务号；推送使用小程序 openid + 公众号模板消息
# ============================================================
WECHAT_PUSH_ENABLED=false
MINIPROGRAM_APPID=
MINIPROGRAM_SECRET=
WECHAT_MP_APPID=
WECHAT_MP_TEMPLATE_ID=
WECHAT_MP_TEMPLATE_URL=https://weixin.qq.com/

# ============================================================
# 存储：上线使用 MySQL
# 本地没有数据库时可改成 json（仅用于演示，不支持自动备份）
# ============================================================
DB_DRIVER=mysql
MYSQL_HOST=10.0.0.10
MYSQL_PORT=3306
MYSQL_USER=math_tutor
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_DATABASE=math_tutor
MYSQL_CONNECTION_LIMIT=10
MYSQL_SSL=false
DB_AUTO_MIGRATE=true

# 中国标准时间 UTC+8；用于“今日提问”统计和备份文件命名
BUSINESS_TIMEZONE_OFFSET_MINUTES=480

# JSON 模式使用；MySQL 模式可保留但不再使用
DATA_DIR=data

# ============================================================
# COS 备份（腾讯云对象存储）
# 建议使用只授权该 Bucket 的子账号密钥
# 云托管容器文件系统是临时的，生产备份必须进 COS
# ============================================================
BACKUP_ENABLED=true
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=math-tutor-backup-1250000000
COS_REGION=ap-shanghai
COS_BACKUP_PREFIX=math-analysis-tutor/backups
BACKUP_CRON=0 3 * * *
BACKUP_TIMEZONE=Asia/Shanghai

# 云托管生产环境请留空，不要把备份写在容器本地
BACKUP_LOCAL_DIR=
MANUAL_BACKUP_RATE_LIMIT_PER_HOUR=10

# ============================================================
# 教学资源文件存储
# auto: 配置 COS 时用 COS，否则本地；cos: 强制 COS；local: 本地
# 云托管必须使用 cos（容器文件系统是临时的）
# ============================================================
RESOURCE_STORAGE=auto
COS_RESOURCE_PREFIX=math-analysis-tutor/resources
RESOURCE_LOCAL_DIR=uploads/resources
RESOURCE_MAX_SIZE_MB=30

# 答疑图片：本地目录 / COS 前缀 / 单图大小上限
QUESTION_IMAGE_LOCAL_DIR=uploads/question-images
COS_QUESTION_IMAGE_PREFIX=math-analysis-tutor/question-images
QUESTION_IMAGE_MAX_SIZE_MB=8

# ============================================================
# 业务限制
# ============================================================
MAX_QUESTION_LENGTH=2000
MAX_CONTEXT_MESSAGES=12
ASK_RATE_LIMIT_PER_MINUTE=10
LIKE_RATE_LIMIT_PER_MINUTE=40
LOGIN_RATE_LIMIT_PER_15_MIN=10
