page {
  height: 100%;
  background: #ededed;
  color: #191919;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei",
    sans-serif;
  font-size: 30rpx;
  -webkit-font-smoothing: antialiased;
}

view,
scroll-view,
text,
textarea,
button,
image {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font-size: inherit;
  line-height: inherit;
}

button::after {
  display: none;
}

image {
  display: block;
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

.tap-active {
  opacity: 0.7;
}

.one-line {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.two-lines {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.muted {
  color: #888888;
}

@keyframes fade-up {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes pulse-dot {
  0%,
  100% {
    opacity: 0.35;
    transform: translateY(0);
  }
  50% {
    opacity: 1;
    transform: translateY(-4rpx);
  }
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
