.page {
  min-height: 100vh;
  padding: 22rpx 24rpx 126rpx;
  padding: 22rpx 24rpx calc(126rpx + env(safe-area-inset-bottom));
  background: #f3f4f3;
}

.history-hero {
  position: relative;
  overflow: hidden;
  margin-bottom: 28rpx;
  padding: 30rpx 30rpx 28rpx;
  border: 1rpx solid #dcece2;
  border-radius: 24rpx;
  background:
    radial-gradient(circle at 92% 8%, rgba(7, 193, 96, 0.13), transparent 38%),
    linear-gradient(135deg, #fbfefc 0%, #edf8f1 100%);
}

.hero-decoration {
  position: absolute;
  right: 8rpx;
  bottom: -48rpx;
  color: rgba(7, 139, 71, 0.055);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 230rpx;
  line-height: 1;
  pointer-events: none;
}

.hero-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 25rpx;
}

.hero-kicker {
  color: #73a287;
  font-size: 17rpx;
  font-weight: 650;
  letter-spacing: 0.17em;
  line-height: 1.4;
}

.privacy-pill {
  display: flex;
  align-items: center;
  gap: 7rpx;
  padding: 7rpx 13rpx;
  border: 1rpx solid rgba(7, 153, 77, 0.13);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.65);
  color: #648371;
  font-size: 18rpx;
  line-height: 1.3;
}

.privacy-lock {
  position: relative;
  width: 11rpx;
  height: 9rpx;
  margin-top: 4rpx;
  border: 1.5rpx solid #6f9b82;
  border-radius: 2rpx;
}

.privacy-lock::before {
  content: "";
  position: absolute;
  top: -8rpx;
  left: 1rpx;
  width: 7rpx;
  height: 7rpx;
  border: 1.5rpx solid #6f9b82;
  border-bottom: 0;
  border-radius: 5rpx 5rpx 0 0;
}

.hero-main {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
}

.hero-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 5rpx;
}

.hero-title {
  color: #183023;
  font-size: 43rpx;
  font-weight: 680;
  letter-spacing: -0.03em;
  line-height: 1.3;
}

.hero-sub {
  color: #7d9185;
  font-size: 21rpx;
  line-height: 1.55;
}

.hero-count {
  display: flex;
  flex: 0 0 auto;
  align-items: baseline;
  gap: 5rpx;
  padding-bottom: 4rpx;
}

.count-number {
  color: #079b4e;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 57rpx;
  font-weight: 700;
  line-height: 1;
}

.count-label {
  color: #7b9485;
  font-size: 19rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4rpx 13rpx;
}

.section-title {
  color: #26352c;
  font-size: 25rpx;
  font-weight: 620;
}

.section-note {
  color: #9aa39d;
  font-size: 19rpx;
}

.question-list {
  overflow: hidden;
  border: 1rpx solid rgba(0, 0, 0, 0.035);
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 22rpx rgba(18, 41, 27, 0.035);
}

.history-row {
  padding: 24rpx 25rpx 22rpx;
  border-bottom: 1rpx solid #f0f2f0;
  transition: background 120ms ease;
}

.history-row:last-child {
  border-bottom: 0;
}

.history-row-hover {
  background: #f7fbf8;
}

.row-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 11rpx;
}

.answered-badge {
  display: flex;
  align-items: center;
  gap: 7rpx;
  padding: 5rpx 11rpx;
  border-radius: 6rpx;
  background: #ecf9f1;
  color: #078f48;
  font-size: 18rpx;
  font-weight: 560;
  line-height: 1.3;
}

.answered-dot {
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #07c160;
}

.row-time {
  color: #a1a8a3;
  font-size: 19rpx;
  line-height: 1.4;
}

.row-question {
  display: -webkit-box;
  overflow: hidden;
  margin-bottom: 7rpx;
  color: #1d2b22;
  font-size: 28rpx;
  font-weight: 560;
  letter-spacing: -0.01em;
  line-height: 1.55;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.row-preview {
  display: block;
  overflow: hidden;
  margin-bottom: 17rpx;
  color: #909992;
  font-size: 21rpx;
  line-height: 1.5;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.row-like {
  display: flex;
  align-items: center;
  gap: 5rpx;
  color: #a0a8a2;
  font-size: 19rpx;
  line-height: 1.3;
}

.like-heart {
  color: #d48491;
  font-size: 22rpx;
}

.row-open {
  display: flex;
  align-items: center;
  gap: 7rpx;
  color: #829b8b;
  font-size: 19rpx;
  line-height: 1.3;
}

.chevron {
  width: 10rpx;
  height: 10rpx;
  border-top: 2rpx solid #9aaca0;
  border-right: 2rpx solid #9aaca0;
  transform: rotate(45deg);
}

.skeleton-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.skeleton-card {
  padding: 26rpx;
  border-radius: 20rpx;
  background: #ffffff;
}

.skeleton-line {
  height: 16rpx;
  margin-bottom: 16rpx;
  border-radius: 5rpx;
  background: linear-gradient(90deg, #f1f4f2 25%, #f9fbfa 50%, #f1f4f2 75%);
  background-size: 200% 100%;
  animation: shimmer 1.3s linear infinite;
}

.skeleton-line:last-child {
  margin-bottom: 0;
}

.skeleton-line.tiny {
  width: 16%;
  height: 12rpx;
}

.skeleton-line.title {
  width: 78%;
  height: 23rpx;
}

.skeleton-line.text {
  width: 94%;
}

.skeleton-line.short {
  width: 46%;
}

.empty-state,
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 74rpx 30rpx 48rpx;
  text-align: center;
}

.empty-illustration {
  position: relative;
  display: flex;
  width: 150rpx;
  height: 124rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 22rpx;
}

.empty-bubble {
  display: flex;
  width: 126rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  border: 1rpx solid #dce8e0;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 25rpx rgba(16, 51, 31, 0.045);
}

.empty-dot {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: #b7cfc0;
}

.empty-sigma {
  position: absolute;
  right: 0;
  bottom: 0;
  display: flex;
  width: 52rpx;
  height: 52rpx;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #f3f4f3;
  border-radius: 50%;
  background: #07c160;
  color: #ffffff;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 26rpx;
  font-weight: 700;
}

.error-symbol {
  display: flex;
  width: 84rpx;
  height: 84rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 22rpx;
  border-radius: 50%;
  background: #fff0f2;
  color: #b84a5e;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 42rpx;
  font-weight: 700;
}

.empty-title {
  margin-bottom: 8rpx;
  color: #26352c;
  font-size: 29rpx;
  font-weight: 620;
  line-height: 1.5;
}

.empty-copy {
  max-width: 480rpx;
  margin-bottom: 28rpx;
  color: #929b95;
  font-size: 22rpx;
  line-height: 1.7;
}

.primary-button {
  display: flex;
  height: 74rpx;
  align-items: center;
  justify-content: center;
  padding: 0 36rpx;
  border-radius: 999rpx;
  background: #07c160;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 560;
  line-height: 1;
  box-shadow: 0 7rpx 20rpx rgba(7, 193, 96, 0.18);
}

.primary-button-hover {
  background: #06ad55;
}

.load-more {
  display: flex;
  height: 82rpx;
  align-items: center;
  justify-content: center;
}

.loading-more {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #9aa39d;
  font-size: 19rpx;
}

.mini-spinner {
  width: 21rpx;
  height: 21rpx;
  border: 3rpx solid #d8e4dc;
  border-top-color: #07c160;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.list-end {
  color: #b1b8b3;
  font-size: 18rpx;
  letter-spacing: 0.04em;
}

/* 教师评论：历史页内联展示 */
.history-teacher-comments {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eef3ef;
}

.history-teacher-comment {
  padding: 16rpx 18rpx;
  border: 1rpx solid #f0c4cb;
  border-radius: 12rpx;
  background: #fffafb;
}

.history-comment-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 6rpx;
}

.history-comment-name {
  color: #5b3d42;
  font-size: 20rpx;
  font-weight: 600;
}

.history-comment-tag {
  color: #a7a0a1;
  font-size: 16rpx;
  line-height: 1.4;
}

.history-comment-time {
  margin-left: auto;
  color: #b5adae;
  font-size: 16rpx;
}

.history-comment-content {
  display: block;
  color: #5f4a4e;
  font-size: 21rpx;
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-word;
}

.history-image {
  display: block;
  width: 176rpx;
  height: 132rpx;
  margin-top: 12rpx;
  border-radius: 9rpx;
  background: #eef3ef;
}
