.workspace-tab-bar {
  position: fixed;
  z-index: 1000;
  right: 0;
  bottom: 0;
  left: 0;
  border-top: 1rpx solid rgba(0, 0, 0, 0.07);
  background: rgba(247, 247, 247, 0.98);
  transition: transform 180ms ease;
}

.workspace-tab-bar-hidden {
  transform: translateY(110%);
}

.workspace-tab-content {
  display: flex;
  height: 104rpx;
  align-items: stretch;
  justify-content: space-around;
  padding: 8rpx 12rpx 0;
}

.workspace-tab-safe {
  height: env(safe-area-inset-bottom);
}

.workspace-tab-item {
  position: relative;
  display: flex;
  width: 25%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3rpx;
  color: #7a7e83;
}

.workspace-tab-hover {
  opacity: 0.68;
}

.workspace-tab-icon-wrap {
  display: flex;
  width: 50rpx;
  height: 50rpx;
  align-items: center;
  justify-content: center;
}

.workspace-tab-icon {
  width: 48rpx;
  height: 48rpx;
}

.workspace-tab-text {
  color: #7a7e83;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.3;
}

.workspace-tab-item.active .workspace-tab-text {
  color: #07c160;
  font-weight: 600;
}

.workspace-active-mark {
  position: absolute;
  top: -9rpx;
  width: 28rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: transparent;
}

.workspace-tab-item.active .workspace-active-mark {
  background: #07c160;
}
