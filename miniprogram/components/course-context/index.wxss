.course-context {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 12rpx 24rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.045);
  background: rgba(255, 255, 255, 0.92);
}

.course-context-main {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 12rpx;
  padding: 7rpx 14rpx 7rpx 8rpx;
  border: 1rpx solid #e1ece4;
  border-radius: 999rpx;
  background: #f5faf6;
}

.course-context-hover {
  opacity: 0.7;
}

.course-context-mark {
  display: flex;
  width: 38rpx;
  height: 38rpx;
  flex: 0 0 38rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(145deg, #24c875, #079b4e);
  box-shadow: inset -2rpx -2rpx 4rpx rgba(0, 0, 0, 0.12);
  color: #fff;
  font-size: 23rpx;
  font-weight: 700;
}

.course-context-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 1rpx;
}

.course-context-label {
  color: #8c998f;
  font-size: 16rpx;
  line-height: 1.2;
}

.course-context-name {
  overflow: hidden;
  max-width: 300rpx;
  color: #26392c;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-context-action {
  flex: 0 0 auto;
  color: #07a854;
  font-size: 18rpx;
}

.course-context-message {
  position: relative;
  display: flex;
  height: 52rpx;
  align-items: center;
  gap: 5rpx;
  padding: 0 14rpx;
  border: 1rpx solid #e2e8e3;
  border-radius: 999rpx;
  color: #58675d;
  font-size: 19rpx;
}

.message-dot {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: #ef6b6b;
}

.message-count {
  color: #e35b5b;
  font-size: 17rpx;
  font-weight: 600;
}
