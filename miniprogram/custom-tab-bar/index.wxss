.tab-bar {
  position: fixed;
  z-index: 1000;
  right: 0;
  bottom: 0;
  left: 0;
  border-top: 1rpx solid rgba(0, 0, 0, 0.07);
  background: rgba(247, 247, 247, 0.98);
  transition: transform 180ms ease;
}

.tab-bar-hidden {
  transform: translateY(110%);
}

.tab-bar-content {
  display: flex;
  height: 104rpx;
  align-items: stretch;
  justify-content: space-around;
  padding: 8rpx 12rpx 0;
}

.tab-bar-safe {
  height: env(safe-area-inset-bottom);
}

.tab-item {
  position: relative;
  display: flex;
  width: 50%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3rpx;
  color: #7a7e83;
}

.tab-item-hover {
  opacity: 0.68;
}

.tab-icon-wrap {
  display: flex;
  width: 50rpx;
  height: 50rpx;
  align-items: center;
  justify-content: center;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
}

.tab-text {
  color: #7a7e83;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.3;
}

.tab-item.active .tab-text {
  color: #07c160;
  font-weight: 600;
}

.active-mark {
  position: absolute;
  top: -9rpx;
  width: 28rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: transparent;
  transition: background 160ms ease;
}

.tab-item.active .active-mark {
  background: #07c160;
}

.tab-icon-wrap {
  position: relative;
}

.tab-badge {
  position: absolute;
  top: -9rpx;
  right: -7rpx;
  display: flex;
  min-width: 25rpx;
  height: 25rpx;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
  border: 2rpx solid #f7f7f7;
  border-radius: 999rpx;
  background: #eb6464;
  color: #fff;
  font-size: 14rpx;
  font-weight: 600;
  line-height: 1;
}
